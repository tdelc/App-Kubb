+# --- Paris sur le champion du tournoi ---------------------------------
+
+get_champion_bets <- function(con, user_id = NULL) {
+  base <- "
+    SELECT b.*, u.pseudo, t.nom AS equipe
+    FROM champion_bets b
+    JOIN users u ON u.user_id = b.user_id
+    JOIN teams t ON t.team_id = b.team_id"
+  if (is.null(user_id)) {
+    dbx_get(con, paste(base, "ORDER BY b.placed_at DESC"))
+  } else {
+    dbx_get(con, paste(base, "WHERE b.user_id = ? ORDER BY b.placed_at DESC"),
+            params = list(user_id))
+  }
+}
+
+# Résultat final du tournoi (1 ligne). champion_ouvert() : marché encore ouvert.
+get_champion_result <- function(con) {
+  r <- dbx_get(con, "SELECT * FROM champion_result WHERE id = 1")
+  if (nrow(r) == 0) return(list(settled = 0, team_id = NA, score = NA))
+  as.list(r)
+}
+
+champion_ouvert <- function(con) {
+  get_champion_result(con)$settled == 0
+}
